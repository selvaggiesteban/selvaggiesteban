:root {
    --wcm-brand:    #292560;
    --wcm-accent:   #3a35a0;
    --wcm-text:     #222;
    --wcm-muted:    #555;
    --wcm-light:    #888;
    --wcm-bg:       #fff;
    --wcm-bg-hover: #f7f7fb;
    --wcm-divider:  #ebebeb;
    --wcm-shadow:   0 12px 40px rgba(0,0,0,.10), 0 2px 8px rgba(0,0,0,.06);
    --wcm-ease:     .22s cubic-bezier(.4,0,.2,1);
    --wcm-radius:   0;
}

/* ── Chevron SVG en ítems con panel ── */
.wcm-chevron {
    display: inline-block;
    width: 11px; height: 11px;
    margin-left: 5px;
    vertical-align: middle;
    opacity: .45;
    transition: transform var(--wcm-ease), opacity var(--wcm-ease);
    position: relative;
    top: -1px;
    flex-shrink: 0;
}
li.wcm-nav-active .wcm-chevron {
    transform: rotate(180deg);
    opacity: 1;
}

/* ── Overlay — NO cubre el header, solo debajo del panel ── */
.wcm-overlay {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    top: 0;
    background: rgba(0,0,0,.12);
    z-index: 99998;
    opacity: 0;
    visibility: hidden;
    transition: opacity .25s ease, visibility .25s ease;
    pointer-events: none;
}
.wcm-overlay.wcm-on {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}

/* ── Panel — transición con opacity+transform, SIN display toggle ── */
.wcm-panel {
    position: fixed;
    left: 0; right: 0;
    width: 100vw;
    max-height: 75vh;
    overflow-y: auto;
    background: var(--wcm-bg);
    border-top: 2.5px solid var(--wcm-brand);
    box-shadow: var(--wcm-shadow);
    z-index: 99999;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity .2s ease, visibility .2s ease, transform .2s ease;
    pointer-events: none;
    will-change: opacity, transform;
}
.wcm-panel.wcm-on {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
}

/* Puente invisible amplio — cubre hueco entre nav y panel */
.wcm-panel::before {
    content: '';
    position: absolute;
    top: -32px;
    left: 0; right: 0;
    height: 32px;
}

/* ── Scrollbar sutil ── */
.wcm-panel::-webkit-scrollbar { width: 4px; }
.wcm-panel::-webkit-scrollbar-thumb { background: var(--wcm-divider); border-radius: 4px; }

/* ── Inner ── */
.wcm-inner {
    margin: 0 auto;
    padding: 28px 44px 22px;
    display: flex;
    align-items: flex-start;
    gap: 0;
}

/* ── MODO COLUMNAS (hijas CON sub-hijas) ── */
.wcm-grid {
    flex: 1;
    order: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    align-items: start;
}
.wcm-grid.cols-1 { grid-template-columns: 1fr; }
.wcm-grid.cols-2 { grid-template-columns: repeat(2, 1fr); }
.wcm-grid.cols-3 { grid-template-columns: repeat(3, 1fr); }
.wcm-grid.cols-5 { grid-template-columns: repeat(5, 1fr); }
.wcm-grid.cols-6 { grid-template-columns: repeat(6, 1fr); }

.wcm-column {
    padding: 0 20px 16px 15px;
    border-right: 1px solid var(--wcm-divider);
}
.wcm-column:last-child { border-right: none; padding-right: 0; }

.wcm-col-heading {
    display: block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--wcm-brand);
    text-decoration: none;
    padding-bottom: 7px;
    margin-bottom: 8px;
    border-bottom: 1.5px solid var(--wcm-brand);
    line-height: 1.3;
    transition: color var(--wcm-ease);
}
.wcm-col-heading:hover { color: var(--wcm-accent); }
.wcm-column ul { list-style: none; margin: 0; padding: 0; }
.wcm-column li { margin: 0; padding: 0; }

/* ── MODO LISTA PLANA (hijas SIN sub-hijas) ── */
.wcm-flat-list {
    flex: 1;
    order: 1;
    column-count: 3;
    column-gap: 32px;
}
.wcm-flat-list.flat-cols-2 { column-count: 2; }
.wcm-flat-list.flat-cols-4 { column-count: 4; }
.wcm-flat-list.flat-cols-5 { column-count: 5; }

.wcm-flat-list a {
    display: flex;
    align-items: center;
    font-size: 13px;
    font-weight: 500;
    color: var(--wcm-text);
    text-decoration: none;
    padding: 7px 10px;
    border-radius: 6px;
    line-height: 1.4;
    break-inside: avoid;
    transition: color var(--wcm-ease), background var(--wcm-ease), padding-left var(--wcm-ease);
}
.wcm-flat-list a::before {
    content: '';
    display: inline-block;
    width: 4px; height: 4px;
    background: var(--wcm-brand);
    border-radius: 50%;
    margin-right: 10px;
    flex-shrink: 0;
    opacity: .35;
    transition: opacity var(--wcm-ease), transform var(--wcm-ease);
}
.wcm-flat-list a:hover {
    color: var(--wcm-brand);
    background: var(--wcm-bg-hover);
    padding-left: 14px;
}
.wcm-flat-list a:hover::before {
    opacity: 1;
    transform: scale(1.3);
}

/* ── MODO MIXTO: bloque compacto para hijas sin sub-hijas ── */
.wcm-compact-block {
    grid-column: 1 / -1;
    padding-top: 14px;
    margin-top: 6px;
    border-top: 1px solid var(--wcm-divider);
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
    align-items: center;
}
.wcm-compact-block .wcm-compact-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .11em;
    text-transform: uppercase;
    color: var(--wcm-light);
    margin-right: 4px;
    white-space: nowrap;
}
.wcm-compact-block a {
    display: inline-block;
    font-size: 12px;
    font-weight: 500;
    color: var(--wcm-text);
    text-decoration: none;
    padding: 4px 14px;
    border: 1px solid var(--wcm-divider);
    border-radius: 100px;
    white-space: nowrap;
    transition: color var(--wcm-ease), background var(--wcm-ease), border-color var(--wcm-ease);
}
.wcm-compact-block a:hover {
    color: var(--wcm-brand);
    border-color: var(--wcm-brand);
    background: var(--wcm-bg-hover);
}

/* Nivel 2 (hijas) */
.wcm-l2 > a {
    display: block;
    font-size: 13px;
    font-weight: 400;
    color: var(--wcm-text);
    text-decoration: none;
    padding: 3px 6px 3px 0;
    line-height: 1.5;
    border-radius: 3px;
    transition: color var(--wcm-ease), padding-left var(--wcm-ease), background var(--wcm-ease);
}
.wcm-l2 > a:hover {
    color: var(--wcm-brand);
    padding-left: 4px;
    background: var(--wcm-bg-hover);
}

/* Nivel 3 (subhijas) */
.wcm-l3 > a {
    display: block;
    font-size: 12px;
    color: var(--wcm-muted);
    text-decoration: none;
    padding: 2px 0 2px 10px;
    margin-left: 4px;
    border-left: 1px solid var(--wcm-divider);
    line-height: 1.4;
    transition: color var(--wcm-ease), border-color var(--wcm-ease);
}
.wcm-l3 > a:hover {
    color: var(--wcm-brand);
    border-left-color: var(--wcm-brand);
}

/* Nivel 4+ */
.wcm-l4 > a, .wcm-l5 > a {
    display: block;
    font-size: 12px;
    color: var(--wcm-light);
    text-decoration: none;
    padding: 2px 0 2px 16px;
    margin-left: 8px;
    border-left: 1px dashed #ddd;
    line-height: 1.35;
    transition: color var(--wcm-ease), border-color var(--wcm-ease);
}
.wcm-l4 > a:hover, .wcm-l5 > a:hover {
    color: var(--wcm-brand);
    border-left-color: var(--wcm-brand);
}

/* ── Resumen DERECHA ── */
.wcm-summary {
    order: 2;
    flex-shrink: 0;
    width: 180px;
    padding-left: 24px;
    margin-left: 22px;
    border-left: 1px solid var(--wcm-divider);
}
.wcm-summary-title {
    display: block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--wcm-brand);
    padding-bottom: 8px;
    margin-bottom: 10px;
    border-bottom: 2px solid var(--wcm-brand);
}
.wcm-summary a {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: var(--wcm-text);
    text-decoration: none;
    padding: 4px 0;
    line-height: 1.4;
    transition: color var(--wcm-ease), padding-left var(--wcm-ease);
}
.wcm-summary a:hover {
    color: var(--wcm-brand);
    padding-left: 4px;
}

/* ── Footer ── */
.wcm-footer {
    border-top: 1px solid var(--wcm-divider);
    padding: 10px 44px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
}
.wcm-footer-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--wcm-light);
    margin-right: 4px;
    white-space: nowrap;
}
.wcm-footer a {
    font-size: 12px;
    font-weight: 600;
    color: var(--wcm-brand);
    text-decoration: none;
    padding: 3px 11px;
    border: 1.5px solid var(--wcm-brand);
    border-radius: 100px;
    white-space: nowrap;
    transition: background var(--wcm-ease), color var(--wcm-ease);
}
.wcm-footer a:hover {
    background: var(--wcm-brand);
    color: #fff;
}

/* ── Ocultar dropdown nativo Etheme ── */
li.wcm-nav-item > ul.sub-menu,
li.wcm-nav-item > .etheme-elementor-nav-menu-dropdown,
li.wcm-nav-item > div[class*="dropdown"] {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
}

/* ── Ítem activo ── */
li.wcm-nav-active > a,
li.wcm-nav-active > a .elementor-item {
    color: var(--wcm-brand) !important;
}

/* ── Móvil ── */
@media (max-width: 1024px) {
    .wcm-panel, .wcm-overlay {
        display: none !important;
        visibility: hidden !important;
    }
    li.wcm-nav-item > ul.sub-menu {
        display: block !important; visibility: visible !important;
        opacity: 1 !important; pointer-events: all !important;
    }
    li.wcm-nav-item > a .elementor-item::after { display: none !important; }
    .wcm-chevron { display: none !important; }
}
</style>
