        /* Calcular ancho del menú padre y pasarlo como CSS var */
        function syncNavWidth() {
            var navWidget = document.querySelector('.etheme-elementor-nav-menu--main');
            if(navWidget) {
                var container = navWidget.closest('.e-con') || navWidget.closest('.elementor-widget');
                if(container) {
                    var w = container.getBoundingClientRect().width;
                    document.documentElement.style.setProperty('--wcm-nav-width', w + 'px');
                }
            }
        }
        syncNavWidth();

        var overlay = document.createElement('div');
        overlay.className = 'wcm-overlay';
        document.body.appendChild(overlay);

        var active = { panel: null, li: null, timer: null };

        /* Buscar el <li> del nav que coincida con la etiqueta */
        function findLi(label) {
            var needle = label.trim().toLowerCase(), found = null;
            document.querySelectorAll(
                '.etheme-elementor-nav-menu li.item-level-0, ' +
                'nav[aria-label] ul > li, ' +
                '.etheme-elementor-nav-menu > ul > li'
            ).forEach(function(li){
                var a = li.querySelector(':scope > a');
                if(a && (a.textContent||'').trim().toLowerCase() === needle) found = li;
            });
            return found;
        }

        /* Construir lista recursiva de hijos */
        function buildList(items, depth) {
            var ul  = document.createElement('ul');
            var cls = 'wcm-l' + Math.min(depth, 5);
            items.forEach(function(item){
                var li = document.createElement('li'); li.className = cls;
                var a  = document.createElement('a');
                a.href = item.url; a.textContent = item.label;
                li.appendChild(a);
                if(item.children && item.children.length)
                    li.appendChild(buildList(item.children, depth + 1));
                ul.appendChild(li);
            });
            return ul;
        }

        /* Construir panel completo */
        function buildPanel(entry) {
            if(!entry.children || !entry.children.length) return null;

            var panel = document.createElement('div'); panel.className = 'wcm-panel';
            var inner = document.createElement('div'); inner.className = 'wcm-inner';

            /* Separar hijas con sub-hijas de las que no tienen */
            var withKids = [], withoutKids = [];
            entry.children.forEach(function(c){
                if(c.children && c.children.length > 0) withKids.push(c);
                else withoutKids.push(c);
            });

            if(withKids.length > 0) {
                /* ── MODO COLUMNAS (puede ser mixto) ── */
                var grid    = document.createElement('div'); grid.className = 'wcm-grid';
                var numCols = Math.min(withKids.length, 6);
                if(numCols !== 4) grid.classList.add('cols-' + numCols);

                withKids.forEach(function(child){
                    var col = document.createElement('div'); col.className = 'wcm-column';
                    var h   = document.createElement('a');
                    h.className = 'wcm-col-heading'; h.href = child.url; h.textContent = child.label;
                    col.appendChild(h);
                    if(child.children && child.children.length)
                        col.appendChild(buildList(child.children, 2));
                    grid.appendChild(col);
                });

                /* Hijas SIN sub-hijas: bloque compacto abajo de las columnas */
                if(withoutKids.length > 0) {
                    var compact = document.createElement('div'); compact.className = 'wcm-compact-block';
                    var clbl = document.createElement('span'); clbl.className = 'wcm-compact-label'; clbl.textContent = 'También:';
                    compact.appendChild(clbl);
                    withoutKids.forEach(function(child){
                        var a = document.createElement('a'); a.href = child.url; a.textContent = child.label;
                        compact.appendChild(a);
                    });
                    grid.appendChild(compact);
                }

                inner.appendChild(grid);
            } else {
                /* ── MODO LISTA PLANA: TODAS las hijas sin sub-hijas ── */
                var flat = document.createElement('div'); flat.className = 'wcm-flat-list';
                var n = withoutKids.length;
                if(n <= 4) flat.classList.add('flat-cols-2');
                else if(n <= 8) flat.classList.add('flat-cols-3');
                else if(n <= 15) flat.classList.add('flat-cols-4');
                else flat.classList.add('flat-cols-5');

                withoutKids.forEach(function(child){
                    var a = document.createElement('a');
                    a.href = child.url; a.textContent = child.label;
                    flat.appendChild(a);
                });
                inner.appendChild(flat);
            }

            /* Resumen derecha */
            var sum = document.createElement('div'); sum.className = 'wcm-summary';
            var t   = document.createElement('span'); t.className = 'wcm-summary-title'; t.textContent = entry.label;
            sum.appendChild(t);
            entry.children.forEach(function(child){
                var a = document.createElement('a'); a.href = child.url; a.textContent = child.label;
                sum.appendChild(a);
            });
            inner.appendChild(sum);
            panel.appendChild(inner);

            /* Footer */
            var footer = document.createElement('div'); footer.className = 'wcm-footer';
            var lbl    = document.createElement('span'); lbl.className = 'wcm-footer-label'; lbl.textContent = 'Ir a:';
            footer.appendChild(lbl);
            var ma = document.createElement('a'); ma.href = entry.url; ma.textContent = 'Todo en ' + entry.label;
            footer.appendChild(ma);
            entry.children.forEach(function(child){
                var a = document.createElement('a'); a.href = child.url; a.textContent = child.label;
                footer.appendChild(a);
            });
            panel.appendChild(footer);
            return panel;
        }

        /* Calcular posición inferior del header (compatible con Elementor sticky) */
        function headerBottom() {
            /* 1. Buscar el nav y subir al contenedor sticky */
            var navEl = document.querySelector('.etheme-elementor-nav-menu--main');
            if(navEl) {
                var sticky = navEl.closest('.elementor-sticky--active');
                if(sticky && sticky.getBoundingClientRect().height > 20)
                    return Math.round(sticky.getBoundingClientRect().bottom);
                /* Si no es sticky aún, usar el widget contenedor */
                var widget = navEl.closest('.elementor-widget');
                if(widget && widget.getBoundingClientRect().height > 20)
                    return Math.round(widget.getBoundingClientRect().bottom);
            }
            /* 2. Fallbacks genéricos */
            var sels = [
                '.elementor-sticky--active',
                '.et-desktop-header',
                '.etheme-header',
                '.site-header',
                'header.header',
                '#masthead',
                'header'
            ];
            for(var i = 0; i < sels.length; i++){
                var el = document.querySelector(sels[i]);
                if(el && el.getBoundingClientRect().height > 20)
                    return Math.round(el.getBoundingClientRect().bottom);
            }
            return 80;
        }
        function posPanel(p){ p.style.top = headerBottom() + 'px'; }

        /* Abrir panel — transición suave sin display toggle */
        function openPanel(panel, li) {
            clearTimeout(active.timer);
            clearTimeout(active.openDelay);
            if(active.panel === panel) return;
            /* Cerrar el anterior sin animación (cambio instantáneo) */
            if(active.panel){
                active.panel.classList.remove('wcm-on');
                active.li.classList.remove('wcm-nav-active');
            }
            posPanel(panel);
            /* Forzar reflow para que la transición se aplique */
            panel.offsetHeight;
            panel.classList.add('wcm-on');
            /* Overlay empieza justo debajo del panel, no cubre el nav */
            overlay.style.top = headerBottom() + 'px';
            overlay.classList.add('wcm-on');
            li.classList.add('wcm-nav-active');
            active.panel = panel;
            active.li    = li;
        }

        /* Cerrar con retardo generoso para evitar parpadeo */
        function scheduleClose() {
            clearTimeout(active.timer);
            clearTimeout(active.openDelay);
            active.timer = setTimeout(function(){
                if(!active.panel) return;
                active.panel.classList.remove('wcm-on');
                overlay.classList.remove('wcm-on');
                active.li.classList.remove('wcm-nav-active');
                active.panel = null;
                active.li    = null;
            }, 380);
        }

        function cancelClose(){ clearTimeout(active.timer); clearTimeout(active.openDelay); }

        /* Vincular cada entrada del menú con su panel */
        nav.forEach(function(entry){
            if(!entry.children || !entry.children.length) return;
            var li = findLi(entry.label);
            if(!li) return;
            var panel = buildPanel(entry);
            if(!panel) return;

            document.body.appendChild(panel);
            li.classList.add('wcm-nav-item');

            /* Inyectar chevron SVG en el enlace del menú */
            var anchor = li.querySelector(':scope > a');
            if(anchor) {
                var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                svg.setAttribute('class', 'wcm-chevron');
                svg.setAttribute('viewBox', '0 0 12 12');
                svg.setAttribute('width', '11');
                svg.setAttribute('height', '11');
                svg.setAttribute('aria-hidden', 'true');
                var path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                path.setAttribute('d', 'M2.5 4.5l3.5 3.5 3.5-3.5');
                path.setAttribute('stroke', 'currentColor');
                path.setAttribute('stroke-width', '1.5');
                path.setAttribute('fill', 'none');
                path.setAttribute('stroke-linecap', 'round');
                path.setAttribute('stroke-linejoin', 'round');
                svg.appendChild(path);
                /* Insertar dentro del .elementor-item si existe, si no dentro del <a> directamente */
                var target = anchor.querySelector('.elementor-item') || anchor;
                target.appendChild(svg);
            }

            /* Función auxiliar: ¿el nodo destino está dentro de una zona segura? */
            function isInsideSafeZone(dest) {
                if(!dest) return false;
                return dest === panel || panel.contains(dest)
                    || dest === li || li.contains(dest)
                    || dest === overlay || dest.closest('.wcm-panel');
            }

            /* mouseenter en <li>: abrir con micro-delay */
            li.addEventListener('mouseenter', function(){
                if(isMob) return;
                cancelClose();
                if(active.panel === panel) return;
                active.openDelay = setTimeout(function(){ openPanel(panel, li); }, 50);
            });

            /* mouseleave en <li>: solo cerrar si sale de la zona segura */
            li.addEventListener('mouseleave', function(e){
                if(isMob) return;
                if(isInsideSafeZone(e.relatedTarget)) { cancelClose(); return; }
                scheduleClose();
            });

            /* mouseenter en panel: siempre cancelar cierre */
            panel.addEventListener('mouseenter', function(){
                cancelClose();
            });

            /* mouseleave en panel: solo cerrar si sale de la zona segura */
            panel.addEventListener('mouseleave', function(e){
                if(isInsideSafeZone(e.relatedTarget)) { cancelClose(); return; }
                scheduleClose();
            });
        });

        overlay.addEventListener('click', function(){ scheduleClose(); });
        document.addEventListener('keydown', function(e){ if(e.key==='Escape') scheduleClose(); });
        window.addEventListener('scroll',  function(){ if(active.panel) posPanel(active.panel); }, {passive:true});
        window.addEventListener('resize',  function(){
            isMob = window.innerWidth<=1024;
            syncNavWidth();
            if(active.panel) posPanel(active.panel);
        });
    });
})();
</script>
