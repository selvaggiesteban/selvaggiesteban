---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import { getLocaleFromUrl, t } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const lang = locale as 'es' | 'en';
const title = t(lang, 'about.title');
const description = t(lang, 'about.description');
---

<BaseLayout {title} {description} isProfile={true} locale="en">
  <Section variant="white" class="pt-24 pb-16 reveal">
    <div class="w-full mx-auto">
      
      <!-- Header: 2 columns -->
      <div class="border-b border-hairline pb-8 mb-8 grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
        <!-- Left column: identity -->
        <div>
          <h1 class="display-lg mb-1">Esteban Selvaggi</h1>
          <p class="text-2xl text-primary font-medium">Computer Engineer</p>
        </div>

        <!-- Right column: share + contact -->
        <div class="flex flex-col gap-5 md:items-end">


          <!-- Contact info -->
          <div class="text-sm text-ink/70 flex flex-col gap-2 md:items-end">
            <a href="mailto:selvaggiesteban@gmail.com" class="hover:text-primary transition-colors font-medium">
              <span class="text-ink/40 font-mono text-xs uppercase tracking-widest mr-1">Email:</span>selvaggiesteban@gmail.com
            </a>
            <a href="tel:+5491153323937" class="hover:text-primary transition-colors font-medium">
              <span class="text-ink/40 font-mono text-xs uppercase tracking-widest mr-1">Phone:</span>(+54) 9 11 5332-3937
            </a>
            <a href="https://linkedin.com/in/selvaggiesteban" target="_blank" class="hover:text-primary transition-colors font-medium">
              <span class="text-ink/40 font-mono text-xs uppercase tracking-widest mr-1">LinkedIn:</span>/selvaggiesteban
            </a>
            <a href="https://github.com/selvaggiesteban" target="_blank" class="hover:text-primary transition-colors font-medium">
              <span class="text-ink/40 font-mono text-xs uppercase tracking-widest mr-1">GitHub:</span>/selvaggiesteban
            </a>
          </div>
        </div>
      </div>

      <!-- Profile -->
      <div class="mb-10">
        <h2 class="text-xl font-bold uppercase tracking-widest text-ink/40 mb-4 border-b border-hairline-soft pb-2">About Me</h2>
        <div class="text-ink/80 space-y-4 leading-relaxed text-sm">
          <p>I am passionate about software engineering and web design, focused on creating exceptional digital experiences that combine careful aesthetics with outstanding performance.</p>
          <p>With over 10 years of experience, I build responsive and scalable web applications, helping businesses and professionals stand out in the digital world with products that load instantly and are optimized for search engines and high conversion rates.</p>
        </div>
      </div>

      <!-- Experience with AI -->
      <div class="mb-10">
        <h2 class="text-xl font-bold uppercase tracking-widest text-ink/40 mb-4 border-b border-hairline-soft pb-2">Experience with Artificial Intelligence</h2>
        <div class="text-ink/80 leading-relaxed text-sm">
          <p>Integration and automation with OpenAI (ChatGPT), Google Gemini, Anthropic Claude and local models via Ollama, RAG (Retrieval Augmented Generation), embeddings and structured content generation, custom virtual assistants and intelligent chatbots. Use of n8n for AI workflow orchestration.</p>
        </div>
      </div>

      <!-- Experience with APIs -->
      <div class="mb-10">
        <h2 class="text-xl font-bold uppercase tracking-widest text-ink/40 mb-4 border-b border-hairline-soft pb-2">Experience with APIs & Integrations</h2>
        <div class="text-ink/80 leading-relaxed text-sm">
          <p>Integration of payment gateways (Mercado Pago, Stripe), messaging APIs (WhatsApp Business API, Telegram Bot API), transactional email gateways (Resend, SMTP), Google APIs (Maps, reCAPTCHA/Turnstile, Search Console, Analytics, Tag Manager, Looker Studio, PageSpeed, Gemini), REST APIs and GraphQL, e-commerce platform synchronization, web scraping with n8n and open APIs.</p>
        </div>
      </div>

      <!-- Languages -->
      <div class="mb-10">
        <h2 class="text-xl font-bold uppercase tracking-widest text-ink/40 mb-4 border-b border-hairline-soft pb-2">Programming Languages & Proficiency</h2>
        <div class="text-ink/80 leading-relaxed text-sm space-y-1">
          <p><span class="font-semibold text-ink">Frontend:</span> React, Vue.js, Next.js, TypeScript, JavaScript, HTML5, CSS3, Sass, Vite, Bootstrap, Astro, Tailwind CSS</p>
          <p><span class="font-semibold text-ink">Backend:</span> PHP, Laravel, CodeIgniter, Composer, Python, Firebase</p>
          <p><span class="font-semibold text-ink">APIs:</span> REST API, GraphQL, Stripe, Mercado Pago, WhatsApp API, Resend</p>
          <p><span class="font-semibold text-ink">Databases:</span> MySQL, SQLite, PostgreSQL, MongoDB</p>
          <p><span class="font-semibold text-ink">Infrastructure:</span> AWS, Azure, Google Cloud, Cloudflare, Docker, GitHub, GitHub Actions, Nginx, Plesk, VPS Linux, Node.js</p>
          <p><span class="font-semibold text-ink">AI:</span> OpenAI, Gemini, Claude, Ollama, n8n</p>
          <p><span class="font-semibold text-ink">Productivity:</span> VS Code, Trello, Monday, ClickUp</p>
          <p><span class="font-semibold text-ink">CMS / E-commerce:</span> WordPress, Elementor, WooCommerce, PrestaShop, Tienda Nube, Shopify</p>
          <p><span class="font-semibold text-ink">SEO & Analytics:</span> Google Analytics, Search Console, Tag Manager, PageSpeed, Looker Studio</p>
        </div>
      </div>

      <!-- Portfolio -->
      <div class="mb-10">
        <h2 class="text-xl font-bold uppercase tracking-widest text-ink/40 mb-4 border-b border-hairline-soft pb-2">Portfolio & Websites Built</h2>
        <div class="text-ink/80 leading-relaxed text-sm">
          <p>Design, development, maintenance and SEO positioning of websites for over 30 clients across various industries, including: Lanús Computación, Esloogan, Vestigio Studio, Octonove Agency, TVMAS Magazine, Te Promocionamos, Nice Comunicación, DMG, among others. Over 100 websites built with modern technologies (Astro, React, WordPress, Laravel).</p>
        </div>
      </div>



      <!-- Education -->
      <div class="mb-10">
        <h2 class="text-xl font-bold uppercase tracking-widest text-ink/40 mb-4 border-b border-hairline-soft pb-2">Education</h2>
        <div class="space-y-4">
          <div>
            <h3 class="font-bold text-lg text-ink">Degree in Computer Engineering - Universidad de Buenos Aires</h3>
            <p class="text-sm text-ink/60 mt-1">Aug 2025 - Dec 2031</p>
          </div>
          <div>
            <h3 class="font-bold text-lg text-ink">Full Stack Web Development - Henry</h3>
            <p class="text-sm text-ink/60 mt-1">Jan 2023 - Dec 2025</p>
          </div>
          <div>
            <h3 class="font-bold text-lg text-ink">Advanced PC Operator - Escuela Santa Teresa</h3>
            <p class="text-sm text-ink/60 mt-1">Mar 2012 - Dec 2018</p>
          </div>
          <div>
            <h3 class="font-bold text-lg text-ink">High School Diploma in Economics and Organization Management - Escuela Santa Teresa</h3>
            <p class="text-sm text-ink/60 mt-1">Mar 2012 - Dec 2018</p>
          </div>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>